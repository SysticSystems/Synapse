# ============================================================================
# Synapse Environment Configuration Template
# ============================================================================

# Project Identity & Build Target
PROJECT_NAME=systic
BUILD_TYPE=Release
CONAN_PROFILE=clang21
CONAN_ENABLED=true

# Conan Server Topology & Authentication
CONAN_REMOTE_NAME=laptop_server
CONAN_REMOTE_URL=http://172.17.0.1:9300
CONAN_LOGIN_USER=systic_user
CONAN_LOGIN_PASSWORD=systic_secret

# Conan Package Architecture
CONAN_PACKAGE_USER=systic
CONAN_PACKAGE_CHANNEL=stable
